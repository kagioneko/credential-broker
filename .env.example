# Secret Source for the DotEnvProvider.
# In production this file is generated on tmpfs from Vault by systemd
# (deploy/fetch-secrets.sh). Do NOT commit a real value.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

